<?xml version="1.0" encoding="utf-8"?>
<!--
  Typography and widget tokens. Applied from Kotlin with
  TextViewCompat.setTextAppearance(...) so the screens stop hardcoding textSize.
-->
<resources>

    <style name="TextAppearance.UsbBridge.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.UsbBridge.BodyDense" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.UsbBridge.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Muted group label above a cluster of rows. -->
    <style name="TextAppearance.UsbBridge.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/brand_on_surface_variant</item>
    </style>

    <!-- Timestamp inside a bubble. -->
    <style name="TextAppearance.UsbBridge.BubbleTime" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Centred system notice (folder changed, send failed) rather than a chat bubble. -->
    <style name="TextAppearance.UsbBridge.Notice" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/brand_on_surface_variant</item>
    </style>

    <!--
      Platform Button styling. android:buttonStyle is not set by Material themes, so
      without this the buttons stay square, grey and ALL-CAPS.
    -->
    <style name="Widget.UsbBridge.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_tonal_button</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <!-- The one screen-defining action, e.g. Start/Stop the bridge. -->
    <style name="Widget.UsbBridge.Button.Primary" parent="Widget.UsbBridge.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/brand_on_primary</item>
    </style>

    <!--
      Button variants cannot be applied by passing a style to a View constructor, so each
      variant gets a theme overlay that overrides android:buttonStyle; build the Button with
      ContextThemeWrapper(context, R.style.ThemeOverlay_UsbBridge_PrimaryButton).
    -->
    <style name="ThemeOverlay.UsbBridge.PrimaryButton" parent="">
        <item name="android:buttonStyle">@style/Widget.UsbBridge.Button.Primary</item>
    </style>

    <!-- Borderless, for secondary inline actions. -->
    <style name="Widget.UsbBridge.Button.Text" parent="Widget.UsbBridge.Button">
        <item name="android:background">@drawable/bg_text_button</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="ThemeOverlay.UsbBridge.TextButton" parent="">
        <item name="android:buttonStyle">@style/Widget.UsbBridge.Button.Text</item>
    </style>

</resources>
